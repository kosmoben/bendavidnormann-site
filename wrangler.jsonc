{
  // Static site for bendavidnormann.com and bendavidnormann.no, served by Cloudflare Workers static assets.
  // worker.js only runs for the front page ("/"), to choose Norwegian or English.
  "name": "bendavidnormann",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  },
  "workers_dev": true
  // Custom domains are added in the next step, once the old Squarespace records are removed:
  // "routes": [
  //   { "pattern": "bendavidnormann.com", "custom_domain": true },
  //   { "pattern": "www.bendavidnormann.com", "custom_domain": true }
  // ]
}
