{
  // Static site for bendavidnormann.com and bendavidnormann.no, served by Cloudflare Workers static assets.
  // worker.js runs for the pages (not images, styles or /en/...), to choose Norwegian or English.
  "name": "bendavidnormann",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/img/*", "!/brand/*", "!/themes/*", "!/en/*", "!/style.css", "!/sky.js", "!/favicon.svg"]
  },
  "workers_dev": true,
  // Cloudflare creates the DNS records for these itself on deploy.
  "routes": [
    { "pattern": "bendavidnormann.com", "custom_domain": true },
    { "pattern": "www.bendavidnormann.com", "custom_domain": true },
    { "pattern": "bendavidnormann.no", "custom_domain": true },
    { "pattern": "www.bendavidnormann.no", "custom_domain": true }
  ]
}
